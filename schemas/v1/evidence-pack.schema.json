{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simpleton.dev/schemas/v1/evidence-pack.schema.json",
  "title": "Simpleton Evidence Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "provenance", "approval", "semantic_advisory", "capabilities", "targets", "methods", "divergences", "witnesses", "replay_capsules", "scoping", "advisory_review", "telemetry", "blockers"],
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "provenance": {"type": "object"},
    "approval": {"type": "object"},
    "semantic_advisory": {"type": "boolean"},
    "capabilities": {"type": "array"},
    "targets": {"type": "array"},
    "methods": {"type": "array"},
    "divergences": {"type": "array"},
    "witnesses": {"type": "array"},
    "replay_capsules": {"type": "array"},
    "scoping": {"type": "object"},
    "advisory_review": {"type": "object"},
    "telemetry": {"type": "object"},
    "proposed_intent_path": {"type": "string"},
    "blockers": {"type": "array"}
  }
}
