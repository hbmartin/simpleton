{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simpleton.dev/schemas/v1/observation-spec.schema.json",
  "title": "Simpleton Observation Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "target", "preconditions", "calls_or_events", "observables", "comparator"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object", "additionalProperties": false, "required": ["language", "scope_type"],
      "properties": {
        "language": {"enum": ["go", "typescript", "python", "swift"]},
        "scope_type": {"enum": ["api", "symbol", "module", "package"]},
        "path": {"type": "string"}, "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_./:#-]*$"}
      },
      "anyOf": [{"required": ["path"]}, {"required": ["symbol"]}]
    },
    "setup": {"type": "array", "items": {"$ref": "#/$defs/hook"}},
    "inputs": {"type": "array"},
    "generator": {"$ref": "#/$defs/hook"},
    "preconditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hook"}},
    "calls_or_events": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "normalizers": {"type": "array", "items": {"$ref": "#/$defs/hook"}},
    "comparator": {"$ref": "#/$defs/hook"},
    "tolerances": {"type": "object", "additionalProperties": false, "properties": {"absolute": {"type": "number", "minimum": 0}, "relative": {"type": "number", "minimum": 0}}}
  },
  "oneOf": [
    {"required": ["inputs"], "not": {"required": ["generator"]}},
    {"required": ["generator"], "not": {"required": ["inputs"]}}
  ],
  "$defs": {
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "built_in": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_./:#-]*$"}
      },
      "oneOf": [
        {"required": ["built_in"], "not": {"required": ["symbol"]}},
        {"required": ["symbol"], "not": {"required": ["built_in"]}}
      ]
    }
  }
}
