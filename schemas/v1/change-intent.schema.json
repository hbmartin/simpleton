{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simpleton.dev/schemas/v1/change-intent.schema.json",
  "title": "Simpleton Change Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "rationale", "classification", "scope", "allowed_changes", "equivalence_contract"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "minLength": 1},
    "rationale": {"type": "string", "minLength": 1},
    "classification": {"enum": ["behavior_preserving", "behavior_changing", "mixed"]},
    "scope": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "properties": {"package": {"type": "string"}, "path": {"type": "string"}, "symbol": {"type": "string"}},
      "anyOf": [{"required": ["package"]}, {"required": ["path"]}, {"required": ["symbol"]}]
    }},
    "allowed_changes": {"type": "array", "items": {"type": "string"}},
    "equivalence_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_mappings", "observations"],
      "properties": {
        "api_mappings": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["before", "after"],
          "properties": {"before": {"type": "string", "minLength": 1}, "after": {"type": "string", "minLength": 1}}
        }},
        "observations": {"type": "array", "items": {"$ref": "observation-spec.schema.json"}}
      }
    }
  }
}
